# ==============================================================================
# DEVFORGE Environment Configuration Template
# Tagline: "From real problems to secure software."
# ==============================================================================

# AI Gateway Providers
# ------------------------------------------------------------------------------
# Primary reasoning model (Gemini 1.5 Pro / Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Ultra-fast secondary failover inference (Llama 3.3 70B / 3.1 8B)
GROQ_API_KEY=your_groq_api_key_here

# Optional ultra-fast inference provider
CEREBRAS_API_KEY=your_cerebras_api_key_here

# GitHub Integration
# ------------------------------------------------------------------------------
# Optional: Increases GitHub REST API rate limits for discovering issues & repo files
GITHUB_TOKEN=your_github_personal_access_token_here

# Persistence (Supabase Cloud or Local JSON File Store)
# ------------------------------------------------------------------------------
# If omitted, DEVFORGE runs smoothly on its local persistent JSON database (data/devforge_db.json)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Public APIs used with Zero Keys Required:
# - OSV.dev (Live Open Source Vulnerability Database by Google)
# - Hacker News Algolia Search API
